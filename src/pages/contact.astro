  <section class="hero section--tight" style="text-align:center;">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>Get in touch</h1>
      <p class="lede" style="margin:0 auto 32px;">Questions about The First Strategy, the apps, or working together &mdash; reach out.</p>
      <a href="mailto:hello@e1c.net" class="btn btn--primary" style="font-size:1.1rem;">hello@e1c.net</a>
    </div>
  </section>
</Layout>
