---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About" description="Why E1C exists, and the philosophy behind The First Strategy.">
  <section class="hero section--tight">
    <div class="container">
      <span class="eyebrow">About</span>
      <h1>Why E1C exists</h1>
      <!-- Placeholder subhead: replace with the real founder story before launch. -->
      <p class="lede">E1C started from a simple frustration: most entrepreneurship advice tells you to build first and find out later. We built The First Strategy &mdash; and E1C itself &mdash; around the opposite idea.</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <span class="eyebrow">The philosophy</span>
      <h2>What we believe</h2>
      <div class="grid grid--3" style="margin-top:32px;">
        <div class="card">
          <h3>Revenue first</h3>
          <p class="muted">We don't trust opinions, including our own. A real sale or a real refusal tells you more than any amount of research.</p>
        </div>
        <div class="card">
          <h3>Free first</h3>
          <p class="muted">Every app and idea we ship gets tested the cheap way before we ever spend real money building it out.</p>
        </div>
        <div class="card">
          <h3>Impact first</h3>
          <p class="muted">We spend our time on whatever's most likely to move things forward &mdash; not whatever's most fun to work on.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="text-align:center;">
    <div class="container">
      <h2>Read the framework</h2>
      <p class="lede" style="margin:0 auto 24px;">See the full three-principle system behind everything we build.</p>
      <a href="/the-first-strategy/" class="btn btn--primary">The First Strategy</a>
    </div>
  </section>
</Layout>
